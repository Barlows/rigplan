# Nothing to build — this is a zero-dependency static app.
# These are here so an exported project or a stray export never lands in the repo.
*.log
*.tmp
.DS_Store
Thumbs.db

# local scratch
scratch/
*.bak
*~

# Scratch drawings dropped in the test folder are not worth keeping. Test pages
# must not read a sibling file, though: this rule sat here silently excluding
# test/fixture.dxf, so the underlay suite passed on every local run and failed on
# CI because the file had never been committed. The reference DXF is inlined in
# the page that needs it.
test/*.dxf

# Generated project files. Regenerate from the source spreadsheet with the
# tools in this folder rather than committing the output.
tools/*.json
