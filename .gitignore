# Nothing to build — this is a zero-dependency static app.
# These are here so an exported project or a stray export never lands in the repo.
*.log
*.tmp
.DS_Store
Thumbs.db

# local scratch
scratch/
*.bak
*~

# test scaffolding not worth keeping
test/*.dxf

# Generated project files. Regenerate from the source spreadsheet with the
# tools in this folder rather than committing the output.
tools/*.json
